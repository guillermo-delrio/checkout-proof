# Copy to .env and fill in once the owner's sandbox REST app exists. Names only; never commit values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Sandbox webhook ID (for verify-webhook-signature)
PAYPAL_WEBHOOK_ID=
# Sandbox personal (buyer) account, Spain
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Sandbox business (merchant) account email, for reference in evidence
PAYPAL_SANDBOX_MERCHANT_EMAIL=
